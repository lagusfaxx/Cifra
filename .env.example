# =====================================================================
# Cifra — variables de entorno
# =====================================================================
# Coolify inyecta los secrets automáticamente. Para dev local copiá este
# archivo a .env y completá los valores. Generá secrets con:
#   openssl rand -hex 32
# =====================================================================

# ---- Dominios (Coolify los inyecta como SERVICE_FQDN_*) -------------
SERVICE_FQDN_WEB=cifra.app
SERVICE_FQDN_API=api.cifra.app

# ---- Postgres -------------------------------------------------------
POSTGRES_USER=cifra
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=cifra

# ---- Redis ----------------------------------------------------------
REDIS_PASSWORD=changeme_dev_only

# ---- MinIO ----------------------------------------------------------
MINIO_ROOT_USER=cifra
MINIO_ROOT_PASSWORD=changeme_dev_only_min_8_chars
MINIO_BUCKET=cifra-attachments

# ---- JWT (256 bits cada uno) ----------------------------------------
# openssl rand -hex 32
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_32

# ---- Hash salts (globales, NO rotables sin migración) ---------------
# openssl rand -hex 32
EMAIL_HASH_SALT=replace_with_openssl_rand_hex_32
USERNAME_HASH_SALT=replace_with_openssl_rand_hex_32

# ---- SMTP (envío códigos de verificación) ---------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cifra <noreply@cifra.app>"

# ---- WebAuthn / Passkeys --------------------------------------------
RP_NAME=Cifra
RP_ID=cifra.app
RP_ORIGIN=https://cifra.app

# ---- Logging --------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=production
